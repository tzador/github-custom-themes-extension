{
  "manifest_version": 3,
  "name": "GitHub Vibed Themes",
  "version": "2.2.0",
  "description": "18 beautiful themes for GitHub - 9 light and 9 dark with hover preview",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://gist.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gist.github.com/*"],
      "css": [
        "themes/sepia.css",
        "themes/solarized.css",
        "themes/solarized-dark.css",
        "themes/gruvbox-light.css",
        "themes/gruvbox-dark.css",
        "themes/ayu-light.css",
        "themes/nord.css",
        "themes/nord-light.css",
        "themes/dracula.css",
        "themes/monokai.css",
        "themes/tokyonight.css",
        "themes/catppuccin.css",
        "themes/catppuccin-latte.css",
        "themes/highcontrast.css",
        "themes/highcontrast-light.css",
        "themes/snowwhite.css",
        "themes/purple.css",
        "themes/purple-light.css",
        "themes.css"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
